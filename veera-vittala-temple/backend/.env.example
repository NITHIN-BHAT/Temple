# Copy this file to .env and change the values.
PORT=5000
ADMIN_USERNAME=admin
# Use a strong password. (Or set ADMIN_PASSWORD_HASH to a bcrypt hash instead.)
ADMIN_PASSWORD=change-this-password
# Long random string — generate one with:  node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
JWT_SECRET=replace-with-a-long-random-string
# Comma-separated list of allowed frontend URLs (leave empty to allow all)
CORS_ORIGIN=
